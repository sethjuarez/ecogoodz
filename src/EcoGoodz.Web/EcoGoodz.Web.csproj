<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\EcoGoodz.Data\EcoGoodz.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5a30681d-1f8c-47aa-8a59-ebff18d7236c</UserSecretsId>
    <!-- We stamp our own short-sha build version below; don't let the SDK also
         auto-append the full git SHA on top of it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Bakes ASPNETCORE_ENVIRONMENT into the generated web.config's <aspNetCore>
    <environmentVariables> element on publish. Not a secret - safe to commit.
    Plesk's hosting plan for this site doesn't expose an environment-variable
    UI, so this is how the app learns it's running in Production (see
    docs/deployment.md for how the actual secrets - connection string, SMTP
    creds - get onto the server instead).
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Dev-only config (DevTools:ShowResetLinkInResponse/AutoLoginEmail, local Docker
      connection string). Both flags are already double-gated on IsDevelopment() in
      code, so shipping this file wouldn't actually be exploitable - but there's no
      reason to ship dev-only settings to a production server at all, so exclude it
      from `dotnet publish` output specifically (still copied for local dev/build).
    -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Build version shown in the footer: vYYYYMMDD.HH.MM.SS+<short-sha>. Computed
    fresh on every build (local or CI), so it always reflects the actual moment
    and commit that produced the running binary - not a manually-bumped number
    that can drift out of sync with what's really deployed.
  -->
  <Target Name="SetBuildVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <PropertyGroup>
      <BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyyyMMdd.HH.mm.ss"))</BuildTimestamp>
    </PropertyGroup>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShortSha" />
    </Exec>
    <PropertyGroup>
      <GitShortSha Condition="'$(GitShortSha)' == ''">local</GitShortSha>
      <InformationalVersion>v$(BuildTimestamp)+$(GitShortSha)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>

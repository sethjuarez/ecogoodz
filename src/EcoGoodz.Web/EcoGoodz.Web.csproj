<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\EcoGoodz.Data\EcoGoodz.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5a30681d-1f8c-47aa-8a59-ebff18d7236c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Dev-only config (DevTools:ShowResetLinkInResponse/AutoLoginEmail, local Docker
      connection string). Both flags are already double-gated on IsDevelopment() in
      code, so shipping this file wouldn't actually be exploitable - but there's no
      reason to ship dev-only settings to a production server at all, so exclude it
      from `dotnet publish` output specifically (still copied for local dev/build).
    -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>

@model EcoGoodz.Web.Models.Buyer.BuyerTrackingSupplierFormViewModel
@{
    ViewData["Title"] = "Add tracking supplier";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Buyer tracking</div>
            <h2 class="page-title">Add supplier</h2>
            <div class="text-secondary">@Model.ProductName</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Tracking" asp-route-userId="@Model.CurrentUserId" class="btn">Back to tracking</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="AddTrackingSupplier" method="post">
            <input asp-for="CurrentUserId" type="hidden" />
            <input asp-for="UserBuyerId" type="hidden" />
            <input asp-for="BuyerTrackingProductId" type="hidden" />
            <input asp-for="BuyerId" type="hidden" />
            <input asp-for="BuyerLocationId" type="hidden" />
            <input asp-for="ProductId" type="hidden" />
            <input asp-for="ProductName" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" asp-items="Model.SupplierOptions" class="form-select" data-searchable-select="true" data-search-url="@Url.Action("SearchTrackingSuppliers", "Buyer", new { productId = Model.ProductId, buyerId = Model.BuyerId, buyerLocationId = Model.BuyerLocationId })">
                    <option value="">Choose a supplier</option>
                </select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SupplierLocationId" class="form-label"></label>
                <select asp-for="SupplierLocationId" asp-items="Model.LocationOptions" class="form-select">
                    <option value="">Choose a location</option>
                </select>
                <span asp-validation-for="SupplierLocationId" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save supplier</button>
                <a asp-action="Tracking" asp-route-userId="@Model.CurrentUserId" class="btn">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (() => {
            const supplier = document.getElementById('SupplierId');
            const location = document.getElementById('SupplierLocationId');
            const buyerTrackingProductId = document.getElementById('BuyerTrackingProductId')?.value;
            const url = '@Url.Action("GetTrackingSupplierLocations", "Buyer")';

            async function loadLocations() {
                const supplierId = supplier.value;
                location.innerHTML = '<option value="">Choose a location</option>';
                if (!supplierId || !buyerTrackingProductId) {
                    return;
                }

                const response = await fetch(`${url}?buyerTrackingProductId=${encodeURIComponent(buyerTrackingProductId)}&supplierId=${encodeURIComponent(supplierId)}`);
                if (!response.ok) {
                    return;
                }

                const items = await response.json();
                for (const item of items) {
                    const option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.text;
                    location.appendChild(option);
                }
            }

            supplier?.addEventListener('change', loadLocations);
        })();
    </script>
}

@model EcoGoodz.Web.Models.Shared.PagedResult<EcoGoodz.Web.Models.Supplier.SupplierListItemViewModel>
@{
    ViewData["Title"] = "Suppliers";
    var favoritesOnly = Model.Page.AdditionalQueryParameters.ContainsKey("favoritesOnly");
}

<div class="page-header d-print-none mb-3 eg-list-workspace">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Partner workspace</div>
            <h2 class="page-title">Suppliers</h2>
            <div class="text-secondary mt-1">@Model.Page.TotalCount total suppliers. Search, segment, then drill into products, buyers, and load activity.</div>
            <nav class="eg-view-tabs" aria-label="Supplier views">
                <a asp-action="Index" asp-route-search="@Model.Page.SearchTerm" asp-route-sort="@Model.Page.SortColumn" asp-route-desc="@Model.Page.SortDescending" asp-route-pageSize="@Model.Page.PageSize" class="eg-view-tab @(!favoritesOnly ? "active" : null)" aria-current="@(!favoritesOnly ? "page" : null)">All suppliers</a>
                <a asp-action="Index" asp-route-favoritesOnly="true" asp-route-search="@Model.Page.SearchTerm" asp-route-sort="@Model.Page.SortColumn" asp-route-desc="@Model.Page.SortDescending" asp-route-pageSize="@Model.Page.PageSize" class="eg-view-tab @(favoritesOnly ? "active" : null)" aria-current="@(favoritesOnly ? "page" : null)">Favorites</a>
                <a asp-action="Tracking" class="eg-view-tab">Tracking</a>
            </nav>
        </div>
        <div class="col-auto ms-auto eg-command-bar">
            @await Html.PartialAsync("_ListSearchBox", Model.Page, new ViewDataDictionary(ViewData) { ["Placeholder"] = "Search suppliers…" })
            <a asp-action="Create" class="btn btn-primary text-nowrap">New supplier</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>@Html.SortableHeader("name", "Name", Model.Page)</th>
                    <th>@Html.SortableHeader("accountManager", "Account manager", Model.Page)</th>
                    <th>@Html.SortableHeader("active", "Active", Model.Page)</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">No suppliers found.</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@item.Id" class="text-reset">@item.Name</a></td>
                        <td>
                            @if (item.AccountManagerId.HasValue)
                            {
                                <a asp-controller="StaffUser" asp-action="Details" asp-route-id="@item.AccountManagerId" class="text-reset">@item.AccountManagerName</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-lt">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_ListPagination", Model.Page)
</div>

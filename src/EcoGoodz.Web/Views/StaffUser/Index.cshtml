@model IReadOnlyList<EcoGoodz.Web.Models.StaffUser.StaffUserListItemViewModel>
@{
    ViewData["Title"] = "Staff users";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title">Staff users</h2>
            <div class="text-secondary mt-1">@Model.Count total</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-primary">New staff user</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Active</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">No staff users found.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@item.Id" class="text-reset">@item.Name</a></td>
                        <td>@item.UserName</td>
                        <td><a href="mailto:@item.Email">@item.Email</a></td>
                        <td>
                            <div>@item.OfficePhone</div>
                            <div class="text-secondary">@item.CellPhone</div>
                        </td>
                        <td>@item.RoleName</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-lt">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

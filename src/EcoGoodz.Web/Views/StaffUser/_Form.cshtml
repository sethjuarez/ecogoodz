@model EcoGoodz.Web.Models.StaffUser.StaffUserFormViewModel

<div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Initials" class="form-label"></label>
            <input asp-for="Initials" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="OfficePhone" class="form-label"></label>
            <input asp-for="OfficePhone" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="CellPhone" class="form-label"></label>
            <input asp-for="CellPhone" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" asp-items="Model.RoleOptions" class="form-select">
                <option value="">Choose role</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-check form-check-inline">
                <input asp-for="IsSendCompanyReport" class="form-check-input" />
                <span class="form-check-label">Send company report</span>
            </label>
            <label class="form-check form-check-inline">
                <input asp-for="IsSendManagerReport" class="form-check-input" />
                <span class="form-check-label">Send manager report</span>
            </label>
            <label class="form-check form-check-inline">
                <input asp-for="IsShowCommunicationReport" class="form-check-input" />
                <span class="form-check-label">Show communication report</span>
            </label>
            <label class="form-check form-check-inline">
                <input asp-for="IsActive" class="form-check-input" />
                <span class="form-check-label">Active</span>
            </label>
        </div>
    </div>
</div>

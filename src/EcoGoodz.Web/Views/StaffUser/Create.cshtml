@model EcoGoodz.Web.Models.StaffUser.StaffUserFormViewModel
@{
    ViewData["Title"] = "New staff user";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Staff users</div>
            <h2 class="page-title">New staff user</h2>
        </div>
    </div>
</div>

<form asp-action="Create" method="post" class="card">
    @await Html.PartialAsync("_Form", Model)
    <div class="card-footer text-end">
        <a asp-action="Index" class="btn">Cancel</a>
        <button type="submit" class="btn btn-primary">Save staff user</button>
    </div>
</form>

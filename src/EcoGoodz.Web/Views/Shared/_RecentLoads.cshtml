@model IReadOnlyList<EcoGoodz.Web.Models.Shared.RecentLoadListItemViewModel>

<div class="card eg-table-card mt-3">
    <div class="card-header">
        <div>
            <div class="eg-card-kicker">Activity</div>
            <h3 class="card-title mb-0">Recent loads</h3>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>Load</th>
                    <th>Shipment date</th>
                    <th>Status</th>
                    <th>Buyer</th>
                    <th>Supplier</th>
                    <th>Buyer location</th>
                    <th>Supplier location</th>
                    <th>Products</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8">
                            <div class="eg-empty-state">
                                <span class="eg-icon-bubble" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="eg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v8H3z" /><path d="M14 10h4l3 3v2h-7z" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" /></svg>
                                </span>
                                <div>No recent loads found.</div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var load in Model)
                {
                    <tr>
                        <td><a asp-controller="Load" asp-action="Details" asp-route-id="@load.Id">#@load.Id</a></td>
                        <td>@load.ShipmentDate?.ToString("yyyy-MM-dd")</td>
                        <td>@load.StatusName</td>
                        <td><a asp-controller="Buyer" asp-action="Details" asp-route-id="@load.BuyerId" class="text-reset">@load.BuyerName</a></td>
                        <td><a asp-controller="Supplier" asp-action="Details" asp-route-id="@load.SupplierId" class="text-reset">@load.SupplierName</a></td>
                        <td><a asp-controller="Location" asp-action="Details" asp-route-id="@load.BuyerLocationId" class="text-reset">@load.BuyerLocationName</a></td>
                        <td><a asp-controller="Location" asp-action="Details" asp-route-id="@load.SupplierLocationId" class="text-reset">@load.SupplierLocationName</a></td>
                        <td>@load.Products</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model IReadOnlyList<EcoGoodz.Web.Models.Shared.RecentLoadListItemViewModel>

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">Recent loads</h3>
    </div>
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>Load</th>
                    <th>Shipment date</th>
                    <th>Status</th>
                    <th>Buyer</th>
                    <th>Supplier</th>
                    <th>Buyer location</th>
                    <th>Supplier location</th>
                    <th>Products</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-4">No recent loads found.</td>
                    </tr>
                }
                @foreach (var load in Model)
                {
                    <tr>
                        <td><a asp-controller="Load" asp-action="Details" asp-route-id="@load.Id">#@load.Id</a></td>
                        <td>@load.ShipmentDate?.ToString("yyyy-MM-dd")</td>
                        <td>@load.StatusName</td>
                        <td>@load.BuyerName</td>
                        <td>@load.SupplierName</td>
                        <td>@load.BuyerLocationName</td>
                        <td>@load.SupplierLocationName</td>
                        <td>@load.Products</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isDashboardActive = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
    var isTradingActive = string.Equals(currentController, "Load", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "BuyerSupplier", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "Communication", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "Note", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "StaffTask", StringComparison.OrdinalIgnoreCase);
    var isPartnersActive = string.Equals(currentController, "Buyer", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "Supplier", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "Location", StringComparison.OrdinalIgnoreCase);
    var isCatalogActive = string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "PackageType", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "BuyerProduct", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "SupplierProduct", StringComparison.OrdinalIgnoreCase);
    var isReportsActive = string.Equals(currentController, "Report", StringComparison.OrdinalIgnoreCase);
    var isAdminActive = string.Equals(currentController, "StaffUser", StringComparison.OrdinalIgnoreCase);
    var userDisplayName = User.Identity?.Name ?? string.Empty;
    var userInitial = string.IsNullOrWhiteSpace(userDisplayName) ? "U" : userDisplayName[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoGoodz</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <!--
        app.css is compiled from styles/app.scss (Tabler + our theme overrides) by
        `npm run build`. It is the ONLY stylesheet the app loads - there is no
        separate Bootstrap/site.css/tokens.css anymore; see styles/app.scss for the
        single source of truth on brand colors/fonts.
    -->
    <link rel="stylesheet" href="~/css/tom-select.bootstrap5.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <a href="#content" class="visually-hidden-focusable skip-link">Skip to main content</a>
    <div class="page">
        <header class="navbar navbar-expand-md navbar-light d-print-none">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand navbar-brand-autodark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="EcoGoodz dashboard">
                    <span class="avatar avatar-sm bg-primary-lt text-primary me-2">EG</span>
                    <span>EcoGoodz</span>
                </a>
                <div class="navbar-nav flex-row order-md-last">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link d-flex lh-1 text-reset px-0" data-bs-toggle="dropdown" aria-label="Open user menu" aria-expanded="false">
                                <span class="avatar avatar-sm bg-primary-lt text-primary">@userInitial</span>
                                <span class="d-none d-xl-block ps-2">
                                    <span>@userDisplayName</span>
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    }
                </div>
                <div class="collapse navbar-collapse" id="navbar-menu">
                    <ul class="navbar-nav">
                        <li class="nav-item @(isDashboardActive ? "active" : null)">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l-2 0l9 -9l9 9l-2 0" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" /><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" /></svg>
                                </span>
                                <span class="nav-link-title">Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown @(isTradingActive ? "active" : null)">
                            <a class="nav-link dropdown-toggle" href="#navbar-trading" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10h14l-4 -4" /><path d="M17 14h-14l4 4" /></svg>
                                </span>
                                <span class="nav-link-title">Trading</span>
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item @(string.Equals(currentController, "Load", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Load" asp-action="Index">Loads</a>
                                <a class="dropdown-item @(string.Equals(currentController, "BuyerSupplier", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="BuyerSupplier" asp-action="Index">Buyer/supplier matches</a>
                                <a class="dropdown-item @(string.Equals(currentController, "Communication", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Communication" asp-action="Index">Communications</a>
                                <a class="dropdown-item @(string.Equals(currentController, "Note", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Note" asp-action="Index">Notes</a>
                                <a class="dropdown-item @(string.Equals(currentController, "StaffTask", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="StaffTask" asp-action="Index">Tasks</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown @(isPartnersActive ? "active" : null)">
                            <a class="nav-link dropdown-toggle" href="#navbar-partners" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 7a4 4 0 1 0 0 8a4 4 0 0 0 0 -8" /><path d="M17 11a3 3 0 1 0 0 6a3 3 0 0 0 0 -6" /><path d="M3 21v-2a4 4 0 0 1 4 -4h4" /><path d="M15 21v-1a3 3 0 0 1 3 -3h1" /></svg>
                                </span>
                                <span class="nav-link-title">Partners</span>
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item @(string.Equals(currentController, "Buyer", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Buyer" asp-action="Index">Buyers</a>
                                <a class="dropdown-item @(string.Equals(currentController, "Supplier", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Supplier" asp-action="Index">Suppliers</a>
                                <a class="dropdown-item @(string.Equals(currentController, "Location", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Location" asp-action="Index">Locations</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown @(isCatalogActive ? "active" : null)">
                            <a class="nav-link dropdown-toggle" href="#navbar-catalog" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9l-8 4.5l-8 -4.5v-9l8 -4.5" /><path d="M12 12l8 -4.5" /><path d="M12 12v9" /><path d="M12 12l-8 -4.5" /></svg>
                                </span>
                                <span class="nav-link-title">Catalog</span>
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item @(string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                                <a class="dropdown-item @(string.Equals(currentController, "BuyerProduct", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="BuyerProduct" asp-action="Index">Buyer products</a>
                                <a class="dropdown-item @(string.Equals(currentController, "SupplierProduct", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="SupplierProduct" asp-action="Index">Supplier products</a>
                                <a class="dropdown-item @(string.Equals(currentController, "PackageType", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="PackageType" asp-action="Index">Package types</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown @(isReportsActive ? "active" : null)">
                            <a class="nav-link dropdown-toggle" href="#navbar-reports" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18" /><path d="M7 16l3 -3l3 2l5 -7" /></svg>
                                </span>
                                <span class="nav-link-title">Reports</span>
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item @(string.Equals(currentController, "Report", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "LastLoadShipped", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Report" asp-action="LastLoadShipped">Last load shipped</a>
                                <a class="dropdown-item @(string.Equals(currentController, "Report", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Communication", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="Report" asp-action="Communication">Communication</a>
                            </div>
                        </li>
                        <li class="nav-item dropdown @(isAdminActive ? "active" : null)">
                            <a class="nav-link dropdown-toggle" href="#navbar-admin" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6a4 4 0 1 0 0 8a4 4 0 0 0 0 -8" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                                </span>
                                <span class="nav-link-title">Admin</span>
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item @(string.Equals(currentController, "StaffUser", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-area="" asp-controller="StaffUser" asp-action="Index">Staff users</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <div class="page-wrapper">
            <main id="content" class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </main>
            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="link-secondary">Privacy</a>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            &copy; 2026 EcoGoodz
                            <span class="text-secondary mx-1">&middot;</span>
                            <span class="text-secondary">@EcoGoodz.Web.BuildInfo.Version</span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/tabler.min.js" asp-append-version="true"></script>
    <script src="~/js/tom-select.complete.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

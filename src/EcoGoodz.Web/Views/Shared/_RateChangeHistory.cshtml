@model IReadOnlyList<EcoGoodz.Web.Models.Shared.RateChangeHistoryItemViewModel>

<div class="table-responsive">
    <table class="table card-table table-vcenter">
        <thead>
            <tr>
                <th>Old effective date</th>
                <th>New effective date</th>
                <th>Old price</th>
                <th>New price</th>
                <th>Changed</th>
                <th>User</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-secondary py-4">No rate changes recorded.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OldEffectiveDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.NewEffectiveDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.OldPrice?.ToString("C")</td>
                    <td>@item.NewPrice?.ToString("C")</td>
                    <td>@item.CreatedDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.UserName</td>
                    <td>@item.Action</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model EcoGoodz.Web.Models.Shared.PageInfo
@{
    // Placeholder text is per-page (e.g. "Search buyers..."); pass it via
    // ViewData when invoking this partial: Html.PartialAsync("_ListSearchBox",
    // Model.Page, new ViewDataDictionary(ViewData) { ["Placeholder"] = "..." })
    var placeholder = ViewData["Placeholder"] as string ?? "Search…";
}
<form method="get" class="list-search-form" role="search">
    @* Preserve sort state across a new search; page always resets to 1 by omission. *@
    @if (!string.IsNullOrWhiteSpace(Model.SortColumn))
    {
        <input type="hidden" name="sort" value="@Model.SortColumn" />
        @if (Model.SortDescending)
        {
            <input type="hidden" name="desc" value="true" />
        }
    }
    @if (Model.PageSize != EcoGoodz.Web.Models.Shared.PageInfo.DefaultPageSize)
    {
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
    }
    @foreach (var parameter in Model.AdditionalQueryParameters)
    {
        <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
    }
    <div class="input-icon">
        <span class="input-icon-addon">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                <path d="M21 21l-6 -6" />
            </svg>
        </span>
        <input type="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="@placeholder" aria-label="@placeholder" />
    </div>
</form>

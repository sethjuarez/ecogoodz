@model EcoGoodz.Web.Models.StaffTask.StaffTaskFormViewModel

<div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="TaskId" type="hidden" />

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DueDate" class="form-label"></label>
            <input asp-for="DueDate" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="AssignedTo" class="form-label"></label>
            <select asp-for="AssignedTo" asp-items="Model.UserOptions" class="form-select">
                <option value="">Choose user</option>
            </select>
            <span asp-validation-for="AssignedTo" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="TaskHeadline" class="form-label"></label>
            <select asp-for="TaskHeadline" asp-items="Model.HeadlineOptions" class="form-select">
                <option value="">Assigned</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <span class="form-check-label">Active</span>
            </label>
        </div>
    </div>
</div>

@model IReadOnlyList<EcoGoodz.Web.Models.StaffTask.StaffTaskHeadlineListItemViewModel>
@{
    ViewData["Title"] = "Task headlines";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Tasks</div>
            <h2 class="page-title">Task headlines</h2>
            <div class="text-secondary mt-1">@Model.Count shown</div>
        </div>
        <div class="col-auto ms-auto d-flex gap-2">
            <a asp-action="CreateHeadline" class="btn btn-primary">New headline</a>
            <a asp-action="Index" class="btn">Back to tasks</a>
        </div>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>Headline</th>
                    <th class="text-end">Open tasks</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-secondary py-4">No task headlines found.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Headline</td>
                        <td class="text-end">@item.OpenTaskCount</td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="EditHeadline" asp-route-id="@item.Id" class="btn btn-sm">Edit</a>
                                <form asp-action="DeactivateHeadline" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

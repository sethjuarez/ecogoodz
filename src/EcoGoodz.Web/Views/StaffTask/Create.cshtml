@model EcoGoodz.Web.Models.StaffTask.StaffTaskFormViewModel
@{
    ViewData["Title"] = "New task";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Tasks</div>
            <h2 class="page-title">New task</h2>
        </div>
    </div>
</div>

<form asp-action="Create" method="post" class="card">
    @await Html.PartialAsync("_Form", Model)
    <div class="card-footer text-end">
        <a asp-action="Index" class="btn">Cancel</a>
        <button type="submit" class="btn btn-primary">Save task</button>
    </div>
</form>

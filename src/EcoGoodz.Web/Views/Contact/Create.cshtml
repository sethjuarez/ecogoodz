@model EcoGoodz.Web.Models.Contact.ContactFormViewModel
@{
    ViewData["Title"] = "New contact";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Contacts</div>
            <h2 class="page-title">New contact</h2>
        </div>
    </div>
</div>

<form asp-action="Create" method="post" class="card">
    @await Html.PartialAsync("_Form", Model)
    <div class="card-footer text-end">
        <a asp-action="Index" asp-route-locationId="@Model.LocationId" class="btn">Cancel</a>
        <button type="submit" class="btn btn-primary">Save contact</button>
    </div>
</form>

@model EcoGoodz.Web.Models.Contact.ContactFormViewModel
@{
    ViewData["Title"] = "Edit contact";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Contacts</div>
            <h2 class="page-title">Edit contact</h2>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    @await Html.PartialAsync("_Form", Model)
    <div class="card-footer d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <div class="d-flex gap-2">
            <a asp-action="Index" asp-route-locationId="@Model.LocationId" class="btn">Cancel</a>
        </div>
    </div>
</form>

<form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="mt-3 text-end">
    <button type="submit" class="btn btn-outline-danger">Deactivate contact</button>
</form>

@model EcoGoodz.Web.Models.Product.ProductFormViewModel
@{
    ViewData["Title"] = "Create product";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Products</div>
            <h2 class="page-title">Create product</h2>
        </div>
    </div>
</div>

<div class="row row-deck">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="IdParent" class="form-label"></label>
                        <select asp-for="IdParent" asp-items="Model.ParentOptions" class="form-select">
                            <option value="">-- none (top-level category) --</option>
                        </select>
                    </div>
                    <label class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <span class="form-check-label">Active</span>
                    </label>
                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <a asp-action="Index" class="btn btn-link">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


@model EcoGoodz.Web.Models.Shared.PagedResult<EcoGoodz.Web.Models.SupplierProduct.SupplierProductListItemViewModel>
@{
    ViewData["Title"] = "Supplier products";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title">Supplier products</h2>
            <div class="text-secondary mt-1">@Model.Page.TotalCount total</div>
        </div>
        <div class="col-auto ms-auto d-flex gap-2">
            @await Html.PartialAsync("_ListSearchBox", Model.Page, new ViewDataDictionary(ViewData) { ["Placeholder"] = "Search supplier products…" })
            <a asp-action="Create" class="btn btn-primary text-nowrap">New supplier product</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>@Html.SortableHeader("supplier", "Supplier", Model.Page)</th>
                    <th>@Html.SortableHeader("location", "Location", Model.Page)</th>
                    <th>@Html.SortableHeader("product", "Product", Model.Page)</th>
                    <th>@Html.SortableHeader("packaging", "Packaging", Model.Page)</th>
                    <th>Current rate</th>
                    <th>@Html.SortableHeader("active", "Active", Model.Page)</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">No supplier products found.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><a asp-controller="Supplier" asp-action="Details" asp-route-id="@item.SupplierId" class="text-reset">@item.SupplierName</a></td>
                        <td><a asp-controller="Location" asp-action="Details" asp-route-id="@item.LocationId" class="text-reset">@item.LocationName</a></td>
                        <td><a asp-action="Details" asp-route-id="@item.Id" class="text-reset">@item.ProductName</a></td>
                        <td>@item.PackagingName</td>
                        <td>@(item.CurrentPrice?.ToString("C")) <span class="text-secondary">@item.CurrentEffectiveDate?.ToString("yyyy-MM-dd")</span></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-lt">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Inactive</span>
                            }
                        </td>
                        <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_ListPagination", Model.Page)
</div>

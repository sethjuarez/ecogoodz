@model EcoGoodz.Web.Models.BuyerSupplier.BuyerSupplierProductDetailsViewModel
@{
    ViewData["Title"] = "Match product rates";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Buyer/Supplier match product</div>
            <h2 class="page-title">@Model.ProductName</h2>
            <div class="text-secondary">@Model.BuyerName &rarr; @Model.SupplierName</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Details" asp-route-id="@Model.BuyerSupplierId" class="btn">Back to match</a>
        </div>
    </div>
</div>

<div class="row row-deck row-cards">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item"><div class="datagrid-title">Product</div><div class="datagrid-content">@Model.ProductName</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Packaging</div><div class="datagrid-content">@Model.PackagingName</div></div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Current supplier rate</div>
                        <div class="datagrid-content">@Model.SupplierPrice?.ToString("C") <span class="text-secondary">@Model.SupplierEffectiveDate?.ToString("yyyy-MM-dd")</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title">Buyer rate history</h3></div>
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead><tr><th>Effective date</th><th>Price</th><th>Created</th><th>User</th><th>Active</th><th class="w-1"></th></tr></thead>
                    <tbody>
                        @if (Model.Rates.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-secondary py-4">No buyer rates found.</td></tr>
                        }
                        @foreach (var rate in Model.Rates)
                        {
                            <tr>
                                <td>@rate.EffectiveDate?.ToString("yyyy-MM-dd")</td>
                                <td>@rate.Price?.ToString("C")</td>
                                <td>@rate.CreatedDate?.ToString("yyyy-MM-dd")</td>
                                <td>@rate.UserName</td>
                                <td>@(rate.IsActive ? "Active" : "Inactive")</td>
                                <td class="text-end">
                                    @if (rate.IsActive)
                                    {
                                        <div class="d-flex gap-2 justify-content-end">
                                            <a asp-action="EditProductRate" asp-route-id="@rate.Id" class="btn btn-sm">Edit</a>
                                            <form asp-action="DeactivateProductRate" asp-route-id="@rate.Id" asp-route-buyerSupplierProductId="@Model.Id" method="post">
                                                <button type="submit" class="btn btn-sm">Deactivate</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Add buyer rate</h3></div>
            <div class="card-body">
                <form asp-action="AddProductRate" method="post">
                    <input asp-for="NewRate.BuyerSupplierId" name="BuyerSupplierId" type="hidden" />
                    <input asp-for="NewRate.BuyerSupplierProductId" name="BuyerSupplierProductId" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="NewRate.Price" class="form-label"></label>
                        <input asp-for="NewRate.Price" name="Price" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewRate.EffectiveDate" class="form-label"></label>
                        <input asp-for="NewRate.EffectiveDate" name="EffectiveDate" class="form-control" type="date" />
                    </div>
                    <button type="submit" class="btn btn-primary">Add rate</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

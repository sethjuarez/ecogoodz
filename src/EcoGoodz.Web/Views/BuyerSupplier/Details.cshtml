@model EcoGoodz.Web.Models.BuyerSupplier.BuyerSupplierDetailsViewModel
@{
    ViewData["Title"] = "Buyer/Supplier match";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Buyer/Supplier matches</div>
            <h2 class="page-title">@Model.BuyerName &rarr; @Model.SupplierName</h2>
        </div>
        <div class="col-auto ms-auto d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn">Back to list</a>
        </div>
    </div>
</div>

<div class="row row-deck row-cards">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Buyer</div>
                        <div class="datagrid-content">@Model.BuyerName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Buyer location</div>
                        <div class="datagrid-content">@Model.BuyerLocationName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Supplier</div>
                        <div class="datagrid-content">@Model.SupplierName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Supplier location</div>
                        <div class="datagrid-content">@Model.SupplierLocationName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Status</div>
                        <div class="datagrid-content">@Model.StatusName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Active</div>
                        <div class="datagrid-content">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-lt">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Inactive</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Created</div>
                        <div class="datagrid-content">@Model.CreateOn</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Updated</div>
                        <div class="datagrid-content">@Model.UpdatedOn</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="text-secondary">Products</div>
                        <div class="h1 m-0">@Model.ProductCount</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Loads</div>
                        <div class="h1 m-0">@Model.LoadCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

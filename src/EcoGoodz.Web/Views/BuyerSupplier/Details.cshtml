@model EcoGoodz.Web.Models.BuyerSupplier.BuyerSupplierDetailsViewModel
@{
    ViewData["Title"] = $"{Model.BuyerName} → {Model.SupplierName}";
    var loadRouteValues = new Dictionary<string, string>();
    if (Model.BuyerId.HasValue)
    {
        loadRouteValues["buyerId"] = Model.BuyerId.Value.ToString();
    }

    if (Model.SupplierId.HasValue)
    {
        loadRouteValues["supplierId"] = Model.SupplierId.Value.ToString();
    }

    if (Model.BuyerLocationId.HasValue)
    {
        loadRouteValues["buyerLocationId"] = Model.BuyerLocationId.Value.ToString();
    }

    if (Model.SupplierLocationId.HasValue)
    {
        loadRouteValues["supplierLocationId"] = Model.SupplierLocationId.Value.ToString();
    }

    var relationshipSummary = new List<EcoGoodz.Web.Models.Shared.RelationshipSummaryItemViewModel>
    {
        new() { Label = "Products", Value = Model.ProductCount.ToString() },
        new()
        {
            Label = "Loads",
            Value = Model.LoadCount.ToString(),
            Controller = "Load",
            Action = "Index",
            RouteValues = loadRouteValues,
        },
    };
}

<div class="page-header d-print-none mb-3 eg-list-workspace">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Buyer/Supplier matches</div>
            <h2 class="page-title">@Model.BuyerName &rarr; @Model.SupplierName</h2>
            <div class="text-secondary mt-1">Deal lane connecting buyer, supplier, locations, assigned products, rates, and load activity.</div>
        </div>
        <div class="col-auto ms-auto eg-command-bar">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn">Back to list</a>
        </div>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row row-cards">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Buyer</div>
                        <div class="datagrid-content">
                            @if (Model.BuyerId.HasValue)
                            {
                                <a asp-controller="Buyer" asp-action="Details" asp-route-id="@Model.BuyerId">@Model.BuyerName</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Buyer location</div>
                        <div class="datagrid-content">
                            @if (Model.BuyerLocationId.HasValue)
                            {
                                <a asp-controller="Location" asp-action="Details" asp-route-id="@Model.BuyerLocationId">@Model.BuyerLocationName</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Supplier</div>
                        <div class="datagrid-content">
                            @if (Model.SupplierId.HasValue)
                            {
                                <a asp-controller="Supplier" asp-action="Details" asp-route-id="@Model.SupplierId">@Model.SupplierName</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Supplier location</div>
                        <div class="datagrid-content">
                            @if (Model.SupplierLocationId.HasValue)
                            {
                                <a asp-controller="Location" asp-action="Details" asp-route-id="@Model.SupplierLocationId">@Model.SupplierLocationName</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Status</div>
                        <div class="datagrid-content">@Model.StatusName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Active</div>
                        <div class="datagrid-content">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-lt">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Inactive</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Created</div>
                        <div class="datagrid-content">@Model.CreateOn</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Updated</div>
                        <div class="datagrid-content">@Model.UpdatedOn</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Assigned products</h3>
            </div>
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Packaging</th>
                            <th>Buyer rate</th>
                            <th>Supplier rate</th>
                            <th class="w-1">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Products.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-secondary py-4">No products assigned to this match yet.</td>
                            </tr>
                        }
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td><a asp-action="ProductDetails" asp-route-id="@product.Id" class="text-reset">@product.ProductName</a></td>
                                <td>@product.PackagingName</td>
                                <td>
                                    @product.BuyerPrice?.ToString("C")
                                    <span class="text-secondary">@product.BuyerEffectiveDate?.ToString("yyyy-MM-dd")</span>
                                </td>
                                <td>
                                    @product.SupplierPrice?.ToString("C")
                                    <span class="text-secondary">@product.SupplierEffectiveDate?.ToString("yyyy-MM-dd")</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="ProductDetails" asp-route-id="@product.Id" class="btn btn-sm">Rates</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="eg-card-kicker">Snapshot</div>
                    <h3 class="card-title mb-0">Relationship activity</h3>
                </div>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("_RelationshipSummary", relationshipSummary)
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Assign product</h3>
            </div>
            <div class="card-body">
                <form asp-action="AddProduct" method="post">
                    <input asp-for="NewProduct.BuyerSupplierId" name="BuyerSupplierId" type="hidden" value="@Model.Id" />
                    <div class="mb-3">
                        <label asp-for="NewProduct.SupplierProduct" class="form-label"></label>
                        <select asp-for="NewProduct.SupplierProduct" name="SupplierProduct" asp-items="Model.NewProduct.SupplierProductOptions" class="form-select" data-searchable-select="true" data-search-url="@Url.Action("SearchSupplierProducts", "BuyerSupplier", new { buyerSupplierId = Model.Id })">
                            <option value="">-- choose supplier product --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewProduct.Price" class="form-label"></label>
                        <input asp-for="NewProduct.Price" name="Price" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewProduct.EffectiveDate" class="form-label"></label>
                        <input asp-for="NewProduct.EffectiveDate" name="EffectiveDate" class="form-control" type="date" />
                    </div>
                    <button type="submit" class="btn btn-primary">Assign product</button>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</div>

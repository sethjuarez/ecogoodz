@model EcoGoodz.Web.Models.Load.LoadFormViewModel
@{
    ViewData["Title"] = "Edit load";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Loads</div>
            <h2 class="page-title">Edit load</h2>
        </div>
    </div>
</div>

<div class="row row-deck">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Buyer" class="form-label"></label>
                            <select asp-for="Buyer" asp-items="Model.BuyerOptions" class="form-select">
                                <option value="">-- select buyer --</option>
                            </select>
                            <span asp-validation-for="Buyer" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Supplier" class="form-label"></label>
                            <select asp-for="Supplier" asp-items="Model.SupplierOptions" class="form-select">
                                <option value="">-- select supplier --</option>
                            </select>
                            <span asp-validation-for="Supplier" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BuyerLocation" class="form-label"></label>
                            <select asp-for="BuyerLocation" asp-items="Model.BuyerLocationOptions" class="form-select" data-searchable-select="true">
                                <option value="">-- select buyer location --</option>
                            </select>
                            <span asp-validation-for="BuyerLocation" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SupplierLocation" class="form-label"></label>
                            <select asp-for="SupplierLocation" asp-items="Model.SupplierLocationOptions" class="form-select" data-searchable-select="true">
                                <option value="">-- select supplier location --</option>
                            </select>
                            <span asp-validation-for="SupplierLocation" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LoadStatus" class="form-label"></label>
                            <select asp-for="LoadStatus" asp-items="Model.StatusOptions" class="form-select">
                                <option value="">-- none --</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ShipmentDate" class="form-label"></label>
                            <input asp-for="ShipmentDate" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Container" class="form-label"></label>
                            <input asp-for="Container" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="BuyerRef" class="form-label"></label>
                            <input asp-for="BuyerRef" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SupplierRef" class="form-label"></label>
                            <input asp-for="SupplierRef" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FreightCarrier" class="form-label"></label>
                        <input asp-for="FreightCarrier" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="SupplierProductIds" class="form-label"></label>
                        <select asp-for="SupplierProductIds" asp-items="Model.SupplierProductOptions" class="form-select" multiple size="6" data-searchable-select="true"></select>
                        <span asp-validation-for="SupplierProductIds" class="text-danger"></span>
                        <div class="form-hint">Hold Ctrl/Cmd to choose multiple supplier products for this load.</div>
                    </div>
                    <label class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <span class="form-check-label">Active</span>
                    </label>
                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@{
    ViewData["Title"] = "Check your email";
}

<h1>Check your email</h1>
<p>If an account exists for that email address, a password reset link has been sent.</p>

@if (TempData["DevResetUrl"] is string devResetUrl)
{
    <div class="alert alert-warning">
        <strong>Development only</strong> - no email server is configured yet, so here's the link directly:
        <br />
        <a href="@devResetUrl">@devResetUrl</a>
    </div>
}

@model EcoGoodz.Web.Models.Location.LocationDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var clientController = Model.ClientType == "Buyer" ? "Buyer" : Model.ClientType == "Supplier" ? "Supplier" : null;
    var relationshipSummary = new List<EcoGoodz.Web.Models.Shared.RelationshipSummaryItemViewModel>
    {
        new()
        {
            Label = "Buyer products",
            Value = Model.BuyerProductCount.ToString(),
            Controller = "BuyerProduct",
            Action = "Index",
            RouteValues = new Dictionary<string, string> { ["locationId"] = Model.Id.ToString() },
        },
        new()
        {
            Label = "Supplier products",
            Value = Model.SupplierProductCount.ToString(),
            Controller = "SupplierProduct",
            Action = "Index",
            RouteValues = new Dictionary<string, string> { ["locationId"] = Model.Id.ToString() },
        },
        new()
        {
            Label = "Loads",
            Value = Model.LoadCount.ToString(),
            Controller = "Load",
            Action = "Index",
            RouteValues = new Dictionary<string, string> { ["locationId"] = Model.Id.ToString() },
        },
        new()
        {
            Label = "Matches",
            Value = Model.MatchCount.ToString(),
            Controller = "BuyerSupplier",
            Action = "Index",
            RouteValues = new Dictionary<string, string> { ["locationId"] = Model.Id.ToString() },
        },
    };
}

<div class="page-header d-print-none mb-3 eg-list-workspace">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Locations</div>
            <h2 class="page-title">@Model.Name</h2>
            <div class="text-secondary mt-1">Location workspace for contacts, notes, products, matches, and load activity.</div>
        </div>
        <div class="col-auto ms-auto eg-command-bar">
            @if (Model.ClientType is not null)
            {
                <form asp-action="ToggleFavorite" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn">@(Model.IsFavorite ? "Remove favorite" : "Add favorite")</button>
                </form>
            }
            <a asp-controller="Contact" asp-action="Index" asp-route-locationId="@Model.Id" class="btn">Contacts</a>
            <a asp-controller="Note" asp-action="Index" asp-route-scope="@(Model.ClientType == "Supplier" ? "SupplierLocation" : "BuyerLocation")" asp-route-id="@Model.Id" class="btn">Notes</a>
            <a asp-action="Create" asp-route-copyFromId="@Model.Id" class="btn">Copy location</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn">Back to list</a>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Client type</div>
                        <div class="datagrid-content">@Model.ClientType</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Client</div>
                        <div class="datagrid-content">
                            @if (clientController is not null && Model.ClientId.HasValue)
                            {
                                <a asp-controller="@clientController" asp-action="Details" asp-route-id="@Model.ClientId">@Model.ClientName</a>
                            }
                            else
                            {
                                @Model.ClientName
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Address</div>
                        <div class="datagrid-content">@Model.Address</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">City</div>
                        <div class="datagrid-content">@Model.City</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">State</div>
                        <div class="datagrid-content">@Model.StateName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Country</div>
                        <div class="datagrid-content">@Model.CountryName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">ZIP / postal code</div>
                        <div class="datagrid-content">@Model.PinCode</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Dock hours</div>
                        <div class="datagrid-content">@Model.DockHours</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Payment terms</div>
                        <div class="datagrid-content">@Model.PaymentTermsName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Buyer status</div>
                        <div class="datagrid-content">@Model.BuyerStatusName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Supplier status</div>
                        <div class="datagrid-content">@Model.SupplierStatusName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Active</div>
                        <div class="datagrid-content">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-lt">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Inactive</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Created</div>
                        <div class="datagrid-content">@Model.CreateOn</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Updated</div>
                        <div class="datagrid-content">@Model.UpdatedOn</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="eg-card-kicker">Snapshot</div>
                    <h3 class="card-title mb-0">Relationships</h3>
                </div>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("_RelationshipSummary", relationshipSummary)
            </div>
        </div>
    </div>
</div>

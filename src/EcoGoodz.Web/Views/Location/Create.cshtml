@model EcoGoodz.Web.Models.Location.LocationFormViewModel
@{
    ViewData["Title"] = "Create location";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Locations</div>
            <h2 class="page-title">Create location</h2>
        </div>
    </div>
</div>

<div class="row row-deck">
    <div class="col-12 col-lg-10">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @await Html.PartialAsync("_Form", Model)
                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <a asp-action="Index" class="btn btn-link">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

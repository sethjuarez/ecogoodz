@model EcoGoodz.Web.Models.Note.NoteFormViewModel
@{
    ViewData["Title"] = "New note";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Notes</div>
            <h2 class="page-title">New note</h2>
        </div>
    </div>
</div>

<form asp-action="Create" method="post" class="card">
    @await Html.PartialAsync("_Form", Model)
    <div class="card-footer text-end">
        <a asp-action="Index" asp-route-scope="@Model.Scope" asp-route-id="@(Model.Scope == "BuyerLocation" ? Model.BuyerLocation : Model.Scope == "SupplierLocation" ? Model.SupplierLocation : Model.Product)" class="btn">Cancel</a>
        <button type="submit" class="btn btn-primary">Save note</button>
    </div>
</form>

@model EcoGoodz.Web.Models.Note.NoteFormViewModel
@{
    ViewData["Title"] = "Edit note";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Notes</div>
            <h2 class="page-title">Edit note</h2>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    @await Html.PartialAsync("_Form", Model)
    <div class="card-footer d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Index" asp-route-scope="@Model.Scope" asp-route-id="@(Model.Scope == "BuyerLocation" ? Model.BuyerLocation : Model.Scope == "SupplierLocation" ? Model.SupplierLocation : Model.Product)" class="btn">Cancel</a>
    </div>
</form>

<form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="mt-3 text-end">
    <button type="submit" class="btn btn-outline-danger">Delete note</button>
</form>

@model EcoGoodz.Web.Models.BuyerProduct.BuyerProductFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3">
    <label asp-for="Buyer" class="form-label"></label>
    <select asp-for="Buyer" asp-items="Model.BuyerOptions" class="form-select" data-searchable-select="true" data-search-url="@Url.Action("SearchBuyers", "BuyerProduct")">
        <option value="">-- choose buyer --</option>
    </select>
    <span asp-validation-for="Buyer" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Location" class="form-label"></label>
    <select asp-for="Location" asp-items="Model.LocationOptions" class="form-select" data-searchable-select="true" data-search-url="@Url.Action("SearchLocations", "BuyerProduct")">
        <option value="">-- choose buyer location --</option>
    </select>
    <span asp-validation-for="Location" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Product" class="form-label"></label>
    <select asp-for="Product" asp-items="Model.ProductOptions" class="form-select" data-searchable-select="true" data-search-url="@Url.Action("SearchProducts", "BuyerProduct")">
        <option value="">-- choose product --</option>
    </select>
    <span asp-validation-for="Product" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="OtherProduct" class="form-label"></label>
    <input asp-for="OtherProduct" class="form-control" />
    <span asp-validation-for="OtherProduct" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Packaging" class="form-label"></label>
    <select asp-for="Packaging" asp-items="Model.PackagingOptions" class="form-select">
        <option value="">-- none --</option>
    </select>
</div>
<div class="mb-3">
    <label asp-for="OtherPackaging" class="form-label"></label>
    <input asp-for="OtherPackaging" class="form-control" />
    <span asp-validation-for="OtherPackaging" class="text-danger"></span>
</div>
<label class="form-check form-switch mb-3">
    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
    <span class="form-check-label">Active</span>
</label>

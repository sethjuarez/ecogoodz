@model EcoGoodz.Web.Models.Communication.CommunicationFormViewModel

<div class="card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="ClientType" class="form-label"></label>
            <select asp-for="ClientType" asp-items="Model.ClientTypeOptions" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="BuyerId" class="form-label"></label>
            <select asp-for="BuyerId" asp-items="Model.BuyerOptions" class="form-select" data-searchable-select="true" data-search-url="@Url.Action("SearchBuyers", "Communication")">
                <option value="">Choose buyer</option>
            </select>
            <span asp-validation-for="BuyerId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" asp-items="Model.SupplierOptions" class="form-select" data-searchable-select="true" data-search-url="@Url.Action("SearchSuppliers", "Communication")">
                <option value="">Choose supplier</option>
            </select>
            <span asp-validation-for="SupplierId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CommunicationType" class="form-label"></label>
            <select asp-for="CommunicationType" asp-items="Model.CommunicationTypeOptions" class="form-select">
                <option value="">Other</option>
            </select>
            <span asp-validation-for="CommunicationType" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OtherType" class="form-label"></label>
            <input asp-for="OtherType" class="form-control" />
            <span asp-validation-for="OtherType" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>
    </div>
</div>

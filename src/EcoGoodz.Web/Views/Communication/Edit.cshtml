@model EcoGoodz.Web.Models.Communication.CommunicationFormViewModel
@{
    ViewData["Title"] = "Edit communication";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Communications</div>
            <h2 class="page-title">Edit communication</h2>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    @await Html.PartialAsync("_Form", Model)
    <div class="card-footer d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Index" asp-route-clientType="@Model.ClientType" asp-route-clientId="@(Model.ClientType == "Buyer" ? Model.BuyerId : Model.SupplierId)" class="btn">Cancel</a>
    </div>
</form>

<form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="mt-3 text-end">
    <button type="submit" class="btn btn-outline-danger">Delete communication</button>
</form>
